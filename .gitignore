# Hidden files and folders (tool caches, editor/agent state, .venv, .pytest_cache, .DS_Store, ...).
# Only the repository's own .gitignore and the results/figures placeholder are published.
.*
!/.gitignore
!final/robotnik_arm_task/results/figures/.gitkeep

# External simulator: assessors clone RoboEnv themselves (README section 3)
RoboEnv/

# Retired experiments: kept locally, not part of the submission
Archive/

# Python environments and caches
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

