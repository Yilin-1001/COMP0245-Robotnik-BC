# Upstream RoboEnv source/build: install it into your own environment instead
RoboEnv/

# Python environments and caches
.venv/
venv/
.pixi/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Only commit the robot assets the final task actually loads
final/robotnik_arm_task/configs/*
!final/robotnik_arm_task/configs/robotnik_arm.json
final/robotnik_arm_task/models/*
!final/robotnik_arm_task/models/summit_xl_arm_description/

# Generated outputs (datasets, checkpoints, plots, logs)
*.log
*.pt
*.pth
*.ckpt
*.npz
*.pkl
final/robotnik_arm_task/data/
final/robotnik_arm_task/checkpoints/
final/robotnik_arm_task/results/**
!final/robotnik_arm_task/results/results.csv
!final/robotnik_arm_task/results/figures/
!final/robotnik_arm_task/results/.gitkeep
!final/robotnik_arm_task/results/figures/.gitkeep
outputs/
runs/
wandb/

